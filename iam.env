# IAMService

# --- PostgreSQL ---
# Prefixed (unlike a plain POSTGRES_*) because the unified compose file loads
# this alongside order.env and inventory.env, and they must not collide.
IAM_POSTGRES_USER=iam
IAM_POSTGRES_PASSWORD=iam
IAM_POSTGRES_DB=iam
# Host-published port for iam-postgres (order uses 5432, inventory 5433).
IAM_POSTGRES_PORT=5434

# --- Redis (sessions) ---
# Host-published port for redis.
REDIS_PORT=6379
# Host-side address for `task run:iam`; the iam container gets redis:6379
# from deploy/compose/docker-compose.yaml instead.
REDIS_ADDRESS=localhost:6379

# Session lifetime (Go duration).
IAM_SESSION_TTL=24h

# Host-side DB_URI: used by `goose` (via Taskfile's `dotenv:`) and
# `task run:iam`. The app container gets its own DB_URI from
# deploy/compose/docker-compose.yaml instead.
DB_URI=postgres://iam:iam@localhost:5434/iam?sslmode=disable

# goose migrations directory (relative to repo root).
MIGRATIONS_DIR=iam/migrations
