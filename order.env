# OrderService

# gRPC addresses of the services Order talks to. With the unified compose
# stack, both Inventory and Payment are containers on the same network and
# reachable by service name.
INVENTORY_SERVICE_ADDRESS=inventory:50051
PAYMENT_SERVICE_ADDRESS=payment:50052

# --- PostgreSQL ---
# Prefixed (unlike a plain POSTGRES_*) because the unified compose file loads
# this alongside inventory.env, and the two must not collide.
ORDER_POSTGRES_USER=order
ORDER_POSTGRES_PASSWORD=order
ORDER_POSTGRES_DB=order
# Host-published port for order-postgres.
ORDER_POSTGRES_PORT=5432

# Host-side DB_URI: used by `goose` (via Taskfile's `dotenv:`) and any
# host-run tooling. The app container gets its own DB_URI from
# deploy/compose/docker-compose.yaml instead (localhost there would mean the
# container itself, not the Postgres container).
DB_URI=postgres://order:order@localhost:5432/order?sslmode=disable

# goose migrations directory (relative to repo root).
MIGRATIONS_DIR=order/migrations
