# InventoryService

# --- PostgreSQL ---
# Prefixed (unlike a plain POSTGRES_*) because the unified compose file loads
# this alongside order.env, and the two must not collide.
INVENTORY_POSTGRES_USER=inventory
INVENTORY_POSTGRES_PASSWORD=inventory
INVENTORY_POSTGRES_DB=inventory
# Host-published port for inventory-postgres. Different from order.env's
# ORDER_POSTGRES_PORT so both can be published on one host at the same time.
INVENTORY_POSTGRES_PORT=5433

# Host-side DB_URI: used by `goose` (via Taskfile's `dotenv:`) and any
# host-run tooling. The app container gets its own DB_URI from
# deploy/compose/docker-compose.yaml instead.
DB_URI=postgres://inventory:inventory@localhost:5433/inventory?sslmode=disable

# goose migrations directory (relative to repo root).
MIGRATIONS_DIR=inventory/migrations
